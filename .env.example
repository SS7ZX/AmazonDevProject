# ---------- MCP server ----------
# Shared secret. If set, every call to /api/mcp must send "Authorization: Bearer <key>".
# Generate one with:  openssl rand -hex 24
MCP_API_KEY=ab4df00d026bc17375935a0a211634e74a814aed8e81abaa

# ---------- Storage (free: Neon Postgres) ----------
# Leave empty to run with in-memory storage (fine for local dev, NOT for Vercel).
DATABASE_URL=postgresql://neondb_owner:npg_WwdG4gblAp7m@ep-curly-queen-b3l9ajbd-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Simulator brain (AWS Bedrock)
# Vercel reserves the AWS_* names, so we use the APP_AWS_* prefix.
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_REGION=us-east-1
# Any Bedrock model that supports tool use via the Converse API.
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ---------- Misc ----------
HOUSEHOLD_TIMEZONE=Asia/Jakarta

# Enables the "Clear demo data" button (leave unset on a public deployment)
ALLOW_DEMO_RESET=1
